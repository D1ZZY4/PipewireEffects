root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.rs]
max_line_length = 100

[*.md]
# Trailing double-spaces are meaningful in Markdown.
trim_trailing_whitespace = false
